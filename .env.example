# Copy this file to `.env` and fill in your own Supabase project's values.
# Expo only exposes environment variables to the app when they are prefixed
# with EXPO_PUBLIC_ â€” see https://docs.expo.dev/guides/environment-variables/
#
# Leave both blank / omit the .env file entirely to run the app in local
# "demo mode" (no backend, data lives on-device only) â€” see README.

# Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
# This is safe to ship in the client app: Row Level Security policies
# (supabase/schema.sql) â€” not this key â€” are what actually restrict access.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary, audited duplicate-walk resolution control. Set to "true" only
# in the approved Staging Preview branch scope and only with the Staging URL.
# Keep blank in Production and all other environments.
EXPO_PUBLIC_STAGING_WALK_DUPLICATE_RESOLUTION=

# PRD section 16: keep a clear support channel from within the app; the
# final support address should come from configuration, not be scattered
# in code. Settings' support row only appears once this is set -- left
# blank/omitted, that row simply doesn't render (never a broken mailto:
# link to a placeholder address).
EXPO_PUBLIC_SUPPORT_EMAIL=


# First-run video tutorial (docs/product/FIRST_RUN_TUTORIAL.md). Leave blank
# until the approved video is hosted: the Help entry then shows a text
# fallback and the automatic first-run invitation is never offered.
# Accepts https:// URLs or same-origin paths starting with "/".
EXPO_PUBLIC_TUTORIAL_VIDEO_URL=
EXPO_PUBLIC_TUTORIAL_VIDEO_URL_ADMIN=
EXPO_PUBLIC_TUTORIAL_VIDEO_URL_MEMBER=
EXPO_PUBLIC_TUTORIAL_CAPTIONS_URL=
EXPO_PUBLIC_TUTORIAL_CAPTIONS_URL_ADMIN=
EXPO_PUBLIC_TUTORIAL_CAPTIONS_URL_MEMBER=
EXPO_PUBLIC_TUTORIAL_POSTER_URL=
# ISO date-time; only profiles created on/after it get the automatic invitation.
EXPO_PUBLIC_TUTORIAL_AUTO_OFFER_SINCE=
