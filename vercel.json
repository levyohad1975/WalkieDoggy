{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/release-guard.js && npx expo export --platform web && node scripts/write-version.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_walkie-auth/otp",
      "has": [
        {
          "type": "host",
          "value": "walkielink.co.il"
        }
      ],
      "destination": "https://zxolmnkevbtorxmcyvnz.supabase.co/auth/v1/otp"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
