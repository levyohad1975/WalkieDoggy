{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "types": [
      "jest",
      "react",
      "react-native",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "index.ts",
    "App.tsx",
    "jest.setup.js"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}
