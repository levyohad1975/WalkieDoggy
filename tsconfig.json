{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "src/*"
                                                  ]
                                      },
                            "ignoreDeprecations":  "6.0",
                            "types":  [
                                          "jest",
                                          "react",
                                          "react-native",
                                          "node"
                                      ]
                        },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx"
                ],
    "exclude":  [
                    "node_modules"
                ]
}
